<Window x:Class="StmHex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StmHex" 
        Height="639" Width="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinHeight="450" MinWidth="550"
        Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="StmHex" 
                   FontSize="24" 
                   FontWeight="Bold"
                   Foreground="#007ACC"
                   Margin="0,0,0,20"
                   HorizontalAlignment="Center"/>

        <!-- Статус подключения + выбор ST-Link -->
        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="8" 
                Padding="15" 
                Margin="0,0,0,15"
                BorderBrush="#E0E0E0" 
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="StatusDot" 
                         Width="14" Height="14" 
                         Fill="#FF5252"
                         VerticalAlignment="Center"/>

                <TextBlock x:Name="TxtStatus" 
                           Grid.Column="1"
                           Text="Не подключено" 
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#333333"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"/>

                <Button x:Name="BtnConnect" 
                        Grid.Column="2"
                        Content="Подключить" 
                        Width="120" Height="30"
                        Margin="15,0,0,0"
                        Background="#007ACC"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="BtnConnect_Click"
                        VerticalAlignment="Center"
                        IsEnabled="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="5"
                                    Padding="10,5">
                                <ContentPresenter HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#CCCCCC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <ComboBox x:Name="CmbStLink"
                          Grid.Column="3"
                          Width="130"
                          Height="25"
                          Margin="10,0,0,0"
                          FontSize="11"
                          VerticalAlignment="Center"
                          SelectionChanged="CmbStLink_SelectionChanged"/>

                <Button x:Name="BtnChangePath" 
                        Grid.Column="4"
                        Content="⚙" 
                        Width="30" Height="30"
                        Margin="10,0,0,0"
                        Background="#607D8B"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="16"
                        ToolTip="Сменить путь к STM32CubeProgrammer"
                        Cursor="Hand"
                        Click="BtnChangePath_Click"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="5"
                                    Padding="5">
                                <ContentPresenter HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Выбор файла -->
        <Border Grid.Row="2" 
                Background="White" 
                CornerRadius="8" 
                Padding="15" 
                Margin="0,0,0,15"
                BorderBrush="#E0E0E0" 
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="HEX файл прошивки:" 
                           FontSize="12"
                           Foreground="#666666"
                           Margin="0,0,0,5"/>

                <TextBox Grid.Row="1" 
                         x:Name="TxtHexPath" 
                         Height="35"
                         FontSize="13"
                         Padding="8,5"
                         VerticalContentAlignment="Center"
                         BorderBrush="#CCCCCC"
                         BorderThickness="1"
                         IsReadOnly="True"
                         Background="#FAFAFA"
                         AllowDrop="True"
                         PreviewDragOver="TxtHexPath_PreviewDragOver"
                         Drop="TxtHexPath_Drop"/>

                <Button Grid.Row="1" Grid.Column="1" 
                        x:Name="BtnBrowse"
                        Content="Обзор..."
                        Width="90" Height="35"
                        Margin="8,0,0,0"
                        Background="#4CAF50"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="BtnBrowse_Click"
                        IsEnabled="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="5"
                                    Padding="10,5">
                                <ContentPresenter HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#CCCCCC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Кнопка прошивки -->
        <Button Grid.Row="3" 
                x:Name="BtnFlash"
                Content="🔧 ЗАПРОГРАММИРОВАТЬ МИКРОКОНТРОЛЛЕР"
                Height="55" 
                FontSize="16" 
                FontWeight="Bold"
                Background="#007ACC"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"
                Margin="0,0,0,10"
                IsEnabled="False"
                Click="BtnFlash_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="8"
                            Padding="15,10">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" 
                                    Property="Background" 
                                    Value="#005A9E"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" 
                                    Property="Background" 
                                    Value="#CCCCCC"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Кнопка очистки -->
        <Button Grid.Row="4" 
                x:Name="BtnErase"
                Content="🧹 ОЧИСТИТЬ МИКРОКОНТРОЛЛЕР"
                Height="40" 
                FontSize="14" 
                FontWeight="SemiBold"
                Background="#FF9800"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"
                Margin="0,0,0,15"
                IsEnabled="False"
                Click="BtnErase_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="8"
                            Padding="15,5">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" 
                                    Property="Background" 
                                    Value="#E65100"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" 
                                    Property="Background" 
                                    Value="#CCCCCC"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Прогресс -->
        <Border Grid.Row="5" 
                Background="White" 
                CornerRadius="8" 
                Padding="15" 
                Margin="0,0,0,15"
                BorderBrush="#E0E0E0" 
                BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="TxtStage" 
                           Text="Ожидание..." 
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#333333"
                           Margin="0,0,0,8"/>

                <ProgressBar x:Name="ProgressBar" 
                             Height="20"
                             Minimum="0" 
                             Maximum="100"
                             Foreground="#4CAF50"
                             Background="#E0E0E0"
                             BorderThickness="0"/>

                <TextBlock x:Name="TxtPercent" 
                           Text="0%" 
                           FontSize="12"
                           Foreground="#666666"
                           HorizontalAlignment="Right"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Лог -->
        <Border Grid.Row="6" 
                Background="White" 
                CornerRadius="8" 
                Padding="10"
                BorderBrush="#E0E0E0" 
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="Лог операций:" 
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#666666"
                           Margin="5,0,0,5"/>

                <ScrollViewer Grid.Row="1" 
                              VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="TxtLog" 
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             FontFamily="Consolas"
                             FontSize="11"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ЗАГЛУШКА ЗАГРУЗКИ -->
        <Border x:Name="LoadingOverlay" 
                Grid.Row="0" 
                Grid.RowSpan="7"
                Background="#F5F5F5"
                Visibility="Visible">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="StmHex" 
                           FontSize="28" 
                           FontWeight="Bold"
                           Foreground="#007ACC"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>
                <ProgressBar Width="200" 
                             Height="3"
                             IsIndeterminate="True"
                             Foreground="#007ACC"/>
                <TextBlock x:Name="TxtLoadingStatus" 
                           Text="Инициализация..." 
                           FontSize="12"
                           Foreground="#666666"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>